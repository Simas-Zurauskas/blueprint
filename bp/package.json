{
  "name": "blueprint-bp",
  "private": true,
  "version": "0.0.0",
  "description": "The blueprint skill's executor: state, I/O, hashing, counting, validation and the run log.",
  "type": "module",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "dev": "node --experimental-strip-types --no-warnings src/bin.ts",
    "build": "echo 'bp has no build step: Node strips types at run time' && npm run typecheck",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . && node scripts/no-focused-tests.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --experimental-strip-types --no-warnings --test --test-reporter=spec \"test/**/*.test.ts\""
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.4",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  }
}
